with "config/spark_rtos_schedulers_config.gpr";
project Spark_Rtos_Schedulers is

   for Library_Name use "Spark_Rtos_Schedulers";
   for Library_Version use Project'Library_Name & ".so." & Spark_Rtos_Schedulers_Config.Crate_Version;

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Spark_Rtos_Schedulers_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("SPARK_RTOS_SCHEDULERS_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      for Default_Switches ("Ada") use Spark_Rtos_Schedulers_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   --  Level 2 supplies sufficient prover effort for ownership/framing VCs.
   --  The intended workflow is:
   --    alr exec -- gnatprove -P spark_rtos_schedulers.gpr --mode=prove
   package Prove is
      for Proof_Switches ("Ada") use ("--mode=prove", "--level=2");
   end Prove;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Spark_Rtos_Schedulers;
